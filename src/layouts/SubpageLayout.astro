---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  subtitle?: string;
  badge?: string;
  image?: string;
  backHref?: string;
  backLabel?: string;
}

const {
  title,
  subtitle,
  badge = 'GSC Salzgitter e.V.',
  image,
  backHref = '/',
  backLabel = '← Zurück zur Startseite',
} = Astro.props;
---

<BaseLayout title={`${title} – GSC Salzgitter e.V.`} description={subtitle || title}>
  <article class="subpage">
    <header class="subpage-hero">
      <div class="container subpage-hero-content">
        <a href={backHref} class="back-pill">{backLabel}</a>
        <h1 class="chapter-title subpage-title">{title}</h1>
        {subtitle && <p class="chapter-lead subpage-lead">{subtitle}</p>}
      </div>
    </header>

    <div class="container subpage-body">
      <div class="subpage-card prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .subpage {
    padding-top: var(--header-height);
    padding-bottom: 4rem;
  }

  .subpage-hero {
    position: relative;
    padding: 2.75rem 0 2rem;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
    background: radial-gradient(circle at 20% 0%, rgba(255, 107, 0, 0.12), transparent 60%), var(--color-bg-dark);
  }

  .subpage-hero-content {
    position: relative;
    z-index: 1;
    max-width: 880px;
  }

  .back-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--color-border);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .back-pill:hover {
    color: #fff;
    border-color: var(--color-primary);
  }

  .subpage-title {
    font-size: clamp(2.1rem, 5vw, 3.2rem);
    margin-bottom: 0.75rem;
  }

  .subpage-lead {
    font-size: clamp(0.98rem, 1.5vw, 1.1rem);
    color: var(--color-text-muted);
    max-width: 60ch;
    line-height: 1.6;
    margin-bottom: 0;
  }

  .subpage-body {
    max-width: 880px;
    margin-top: 2rem;
  }

  .subpage-card {
    background: var(--color-bg-dark);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: clamp(1.35rem, 4vw, 2.75rem);
  }

  @media (max-width: 44em) {
    .subpage-card {
      background: transparent;
      border: none;
      padding: 0;
    }
  }
</style>
