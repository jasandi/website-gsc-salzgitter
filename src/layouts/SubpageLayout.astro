---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  subtitle?: string;
  badge?: string;
  image?: string;
  backHref?: string;
  backLabel?: string;
}

const {
  title,
  subtitle,
  badge = 'GSC Salzgitter e.V.',
  image,
  backHref = '/',
  backLabel = '← Zurück zur Startseite',
} = Astro.props;
---

<BaseLayout title={`${title} – GSC Salzgitter e.V.`} description={subtitle || title}>
  <article class="subpage">
    <header class="subpage-hero">
      {image && (
        <div class="subpage-hero-bg" aria-hidden="true">
          <img src={image} alt="" loading="eager" />
          <div class="subpage-hero-scrim"></div>
        </div>
      )}
      <div class="container subpage-hero-content">
        <a href={backHref} class="back-pill">{backLabel}</a>
        <h1 class="subpage-title">{title}</h1>
        {subtitle && <p class="subpage-lead">{subtitle}</p>}
      </div>
    </header>

    <div class="container subpage-body">
      {image && (
        <figure class="subpage-featured-media">
          <img src={image} alt={title} loading="eager" />
        </figure>
      )}
      <div class="subpage-card prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .subpage {
    padding-top: var(--header-height);
    padding-bottom: 4rem;
  }

  .subpage-hero {
    position: relative;
    padding: 3rem 0 2.5rem;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
    background: radial-gradient(circle at 20% 0%, rgba(255, 107, 0, 0.16), transparent 60%), var(--color-bg-dark);
  }

  .subpage-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.22;
    filter: blur(22px) saturate(1.2);
    transform: scale(1.1);
  }

  .subpage-hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .subpage-hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(5, 5, 6, 0.4), var(--color-bg-black));
  }

  .subpage-hero-content {
    position: relative;
    z-index: 1;
    max-width: 880px;
  }

  .back-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--color-border);
  }

  .back-pill:hover {
    color: #fff;
    border-color: var(--color-primary);
  }

  .subpage-title {
    font-size: clamp(2rem, 5.5vw, 3.35rem);
    margin-bottom: 0.75rem;
  }

  .subpage-lead {
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
    color: var(--color-text-muted);
    max-width: 65ch;
  }

  .subpage-body {
    max-width: 880px;
    margin-top: 2rem;
  }

  .subpage-featured-media {
    margin-bottom: 2rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }

  .subpage-featured-media img {
    width: 100%;
    max-height: 460px;
    object-fit: cover;
  }

  .subpage-card {
    background: var(--color-bg-dark);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: clamp(1.35rem, 4vw, 2.75rem);
  }
</style>
