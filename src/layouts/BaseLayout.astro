---
import '../styles/fonts.css';
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  isHome?: boolean;
}

const {
  title = 'GSC Salzgitter e.V. im ADAC · Motocross & Supercross am Hüttenring',
  description = 'Motocross Verein und Strecke für alle Altersklassen in Salzgitter-Watenstedt: 1.900m Hüttenring, Supercross & Kinderstrecke.',
  isHome = false,
} = Astro.props;

const schemaOrg = {
  '@context': 'https://schema.org',
  '@type': 'SportsClub',
  name: 'GSC Salzgitter e.V. im ADAC',
  url: 'https://www.gsc-salzgitter.de',
  description: 'Motocross Verein und Strecke für alle Altersklassen.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Eisenhüttenstraße',
    addressLocality: 'Salzgitter',
    postalCode: '38239',
    addressCountry: 'DE',
  },
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050506" />
    <link rel="icon" href="/assets/favicon.png" />
    <link rel="preload" href="/assets/fonts/outfit-800.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/roboto-400.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
  </head>
  <body>
    <Navigation isHome={isHome} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
