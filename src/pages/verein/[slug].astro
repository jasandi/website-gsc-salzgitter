    color: var(--color-primary);
  }

  .satzung-item-icon {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--color-primary-soft);
    color: var(--color-primary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    flex-shrink: 0;
    transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  .satzung-item[open] .satzung-item-icon {
    transform: rotate(45deg);
    background: var(--color-primary);
    color: #fff;
  }

  .satzung-item-body {
    padding: 0.2rem 1.2rem 1.2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .satzung-item-body p {
    margin: 0.75rem 0 0;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .satzung-item-body .roman-list {
    margin-top: 0.75rem;
  }

  .roman-list {
    list-style-type: upper-roman;
    padding-left: 1.6rem;
    margin: 0;
    display: grid;
    gap: 0.75rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .arabic-list {
    list-style-type: decimal;
    padding-left: 1.5rem;
    margin-top: 0.5rem;
    display: grid;
    gap: 0.35rem;
  }

  .alpha-list {
    list-style: none;
    counter-reset: alpha-counter;
    padding-left: 1.5rem;
    margin-top: 0.5rem;
    display: grid;
    gap: 0.35rem;
    color: var(--color-text-muted);
  }

  .alpha-list > li {
    counter-increment: alpha-counter;
    position: relative;
  }

  .alpha-list > li::before {
    content: counter(alpha-counter, lower-alpha) ') ';
    position: absolute;
    left: -1.5rem;
  }
</style>

<script>
  function initClubCalculator() {
    const ageButtons = document.querySelectorAll<HTMLButtonElement>('[data-age]');
    if (ageButtons.length === 0) return;

    const usageButtons = document.querySelectorAll<HTMLButtonElement>('[data-usage]');
    const workButtons = document.querySelectorAll<HTMLButtonElement>('[data-work]');
    const usageGroup = document.getElementById('calc-usage-group');
    const workGroup = document.getElementById('calc-work-group');
    const resultPanel = document.getElementById('calc-result-panel') || document.querySelector<HTMLElement>('.calc-result');

    const summaryTitle = document.getElementById('calc-summary-title');
    const monthlyHint = document.getElementById('calc-monthly-hint');
    const valYearly = document.getElementById('calc-val-yearly');
    const workHint = document.getElementById('calc-work-hint');
    const valWork = document.getElementById('calc-val-work');
    const totalRecurring = document.getElementById('calc-total-recurring');
    const entryHint = document.getElementById('calc-entry-hint');
    const valEntry = document.getElementById('calc-val-entry');
    const totalFirst = document.getElementById('calc-total-first');
    const nextYears = document.getElementById('calc-next-years');

    let yearlyFee: number | null = null;
    let entryFee: number | null = null;
    let titleText: string | null = null;
    let usageMode: 'active' | 'rare' | null = null;
    let workMode: 'done' | 'skipped' | null = null;

    const formatEUR = (n: number) =>
      n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';

    function updateCalculator() {
      const hasAge = yearlyFee !== null && entryFee !== null;
      const requiresWork = usageMode === 'active';
      const hasUsage = usageMode !== null;

      if (workGroup) {
        workGroup.classList.toggle('is-disabled', !requiresWork);
      }

      if (monthlyHint) {
        if (hasAge) {
          monthlyHint.textContent = `Konditionen für ${titleText}`;
          monthlyHint.style.display = '';
        } else {
          monthlyHint.textContent = '';
          monthlyHint.style.display = 'none';
        }
      }
      if (valYearly) valYearly.textContent = hasAge ? formatEUR(yearlyFee!) : '–';
      if (valEntry) valEntry.textContent = hasAge ? '+ ' + formatEUR(entryFee!) : '–';

      let workFee = 0;
      let hasWorkFeeValue = false;

      if (workHint && valWork) {
        if (!hasUsage) {
          workHint.textContent = '';
          workHint.style.display = 'none';
          valWork.textContent = '–';
        } else if (!requiresWork) {
          workHint.textContent = 'Unter 2× Streckennutzung (kein Arbeitsdienst)';
          workHint.style.display = '';
          valWork.textContent = formatEUR(0);
          workFee = 0;
          hasWorkFeeValue = true;
        } else {
          if (workMode === 'done') {
            workHint.textContent = '6 Std. geleistet';
            workHint.style.display = '';
            valWork.textContent = formatEUR(0);
            workFee = 0;
            hasWorkFeeValue = true;
          } else if (workMode === 'skipped') {
            workHint.textContent = 'Keine Std. geleistet';
            workHint.style.display = '';
            valWork.textContent = formatEUR(60);
            workFee = 60;
            hasWorkFeeValue = true;
          } else {
            workHint.textContent = '6 Std. Arbeitsdienst erforderlich';
            workHint.style.display = '';
            valWork.textContent = '–';
          }
        }
      }

      const isComplete = hasAge && (usageMode === 'rare' || (usageMode === 'active' && workMode !== null));

      if (totalRecurring && totalFirst) {
        if (isComplete) {
          const recurringTotal = yearlyFee! + workFee;
          const firstYearTotal = recurringTotal + entryFee!;
          totalRecurring.textContent = formatEUR(recurringTotal);
          totalFirst.textContent = formatEUR(firstYearTotal);
        } else {
          totalRecurring.textContent = '–';
          totalFirst.textContent = '–';
        }
      }
    }

    function scrollToBlock(el: HTMLElement | null) {
      if (!el) return;
      if (!window.matchMedia('(max-width: 51.99em)').matches) return;

      setTimeout(() => {
        const header = document.getElementById('site-header');
        const headerHeight = header ? header.getBoundingClientRect().height : 82;
        const offset = headerHeight + 12;
        const top = el.getBoundingClientRect().top + window.scrollY - offset;

        window.scrollTo({
          top: Math.max(0, top),
          behavior: 'smooth',
        });
      }, 80);
    }

    ageButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        ageButtons.forEach((b) => {
          b.classList.remove('is-selected');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('is-selected');
        btn.setAttribute('aria-pressed', 'true');
        yearlyFee = Number(btn.dataset.yearly || 0);
        entryFee = Number(btn.dataset.entry || 0);
        titleText = btn.dataset.title || '';
        updateCalculator();
        scrollToBlock(usageGroup);
      });
    });

    usageButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        usageButtons.forEach((b) => {
          b.classList.remove('is-selected');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('is-selected');
        btn.setAttribute('aria-pressed', 'true');
        usageMode = (btn.dataset.usage as 'active' | 'rare') || 'active';
        if (usageMode === 'rare') {
          workMode = null;
          workButtons.forEach((b) => {
            b.classList.remove('is-selected');
            b.setAttribute('aria-pressed', 'false');
          });
        }
        updateCalculator();
        scrollToBlock(usageMode === 'active' ? workGroup : resultPanel);
      });
    });

    workButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        workButtons.forEach((b) => {
          b.classList.remove('is-selected');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('is-selected');
        btn.setAttribute('aria-pressed', 'true');
        workMode = (btn.dataset.work as 'done' | 'skipped') || 'done';
        updateCalculator();
        scrollToBlock(resultPanel);
      });
    });

    updateCalculator();
  }

  function initSatzungAccordion() {
    const toggleAllBtn = document.getElementById('satzung-toggle-all');
    const toggleAllLabel = document.getElementById('satzung-toggle-all-label');
    const satzungItems = Array.from(document.querySelectorAll<HTMLDetailsElement>('.satzung-item'));
    if (!toggleAllBtn || satzungItems.length === 0) return;

    function syncToggleAllState() {
      if (!toggleAllBtn || !toggleAllLabel) return;
      const allOpen = satzungItems.every((item) => item.open);
      toggleAllBtn.setAttribute('aria-expanded', String(allOpen));
      toggleAllLabel.textContent = allOpen ? 'Alle zuklappen' : 'Alle aufklappen';
    }

    toggleAllBtn.addEventListener('click', () => {
      const allOpen = satzungItems.every((item) => item.open);
      const nextState = !allOpen;
      satzungItems.forEach((item) => {
        item.open = nextState;
      });
      syncToggleAllState();
    });

    satzungItems.forEach((item) => {
      item.addEventListener('toggle', syncToggleAllState);
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    initClubCalculator();
    initSatzungAccordion();
  });
</script>
