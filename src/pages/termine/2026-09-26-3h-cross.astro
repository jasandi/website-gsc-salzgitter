import SubpageLayout from '../../layouts/SubpageLayout.astro';
---

<SubpageLayout
  title="3h Motocross"
  subtitle="Lizenzfreies Ausdauer-Motocross-Rennen im GSC Salzgitter."
  badge="Ausschreibung · 26. September 2026"
  image="/assets/3h-cross-bild.jpg"
  backHref="/#termine"
  backLabel="← Zurück zu den Terminen"
>
  <h2>Zeitplan</h2>
  <ul>
    <li><strong>10:00–11:00 Uhr:</strong> Anmeldung &amp; Transponderausgabe</li>
    <li><strong>11:00–13:00 Uhr:</strong> Pflichttraining – mindestens eine gemessene Runde</li>
    <li><strong>14:30 Uhr:</strong> Startaufstellung auf der Startgeraden</li>
    <li><strong>15:00 Uhr:</strong> Start des Rennens → Die Fahrer laufen zu ihren Motorrädern. Motoren bleiben zunächst aus</li>
    <li><strong>18:00 Uhr:</strong> Zielflagge</li>
    <li><strong>19:00 Uhr:</strong> Siegerehrung am Vereinsheim</li>
    <li><strong>ab 20:00 Uhr:</strong> After-Race-Party</li>
  </ul>

  <h2>Teilnahme &amp; Klassen</h2>
  <h3>Erwachsenenklasse</h3>
  <ul>
    <li>ab 125 ccm 2-Takt und 250 ccm 4-Takt</li>
    <li>Erwachsenenteams dürfen mit 1–2 Motorrädern und Fahrern pro Team antreten</li>
  </ul>

  <h3>Jugendklasse</h3>
  <ul>
    <li>ausschließlich 85 ccm</li>
    <li>Jugendteams dürfen mit 1–3 Motorrädern und Fahrern pro Team antreten</li>
  </ul>

  <h2>Fahrerwechsel</h2>
  <p>
    Der Wechsel der Teamfahrer ist ausschließlich im ausgewiesenen Wechselbereich neben dem Zuschauersprung erlaubt.
  </p>

  <h2>Tanken &amp; Umwelt</h2>
  <p>
    Tanken ist ausschließlich auf einer geeigneten Umweltmatte erlaubt. Das Motorrad muss nicht zugelassen sein.
  </p>

  <h2>Anmeldung</h2>
  <ul>
    <li><strong>GSC-Mitglieder:</strong> kostenlos</li>
    <li><strong>Gastfahrer:</strong> 30 € Streckennutzungsgebühr</li>
    <li>Bei einer Teammeldung kann der 2. Fahrer bis Freitag, 25.09.2026, 18:00 Uhr nachgemeldet werden.</li>
  </ul>

  <div style="margin: 1.75rem 0;">
    <a
      href="https://mx-tickets.com/de-DE/t/gsc-salzgitter/events"
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-primary"
    >
      Zur Anmeldung →
    </a>
  </div>

  <h2>Zeitnahme</h2>
  <p>Die elektronische Zeitnahme erfolgt durch Firma Dennis Timing.</p>

  <h2>Streckenbedingungen</h2>
  <p>
    Bei hoher Staubentwicklung behalten wir uns vor, die Strecke auch während des Rennens zu bewässern,
    um die Streckenbedingungen und die Sicherheit der Fahrer zu verbessern.
  </p>
</SubpageLayout>
